#!/bin/sh
# Blocks a commit that would put a real credential into a tracked settings file.
#
# Distinguishes placeholders from secrets rather than flagging any non-empty value: a rule
# that cries wolf on an empty value gets bypassed with --no-verify, and then it protects
# nothing. Development files are exempt — their values are local-only by design.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep 'appsettings.*\.json$')
[ -z "$staged" ] && exit 0

# Values that are obviously not secrets: empty, or a marker telling a human to fill it in.
placeholder='^$|^\[.*\]$|^<.*>$|^(CHANGE_ME|REQUIRED|TODO|xxx+|\.\.\.)$|^\$\{.*\}$'

# Shapes that are almost certainly real: a UUID, a long random-looking string, or a token
# carrying a known vendor prefix.
looks_real='^[0-9a-fA-F-]{32,}$|^[A-Za-z0-9+/=_-]{24,}$|^(npm_|ghp_|github_pat_|SCW|sk-|xox)'

fail=0
for file in $staged; do
  case "$file" in
    *Development.json) continue ;;
  esac

  # One "key": "value" pair per line, for the fields worth guarding.
  git show ":$file" \
    | grep -oE '"(ApiKey|SecretKey|AccessKey|SigningKey|Password|Token|ClientSecret)"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | while IFS= read -r pair; do
        key=$(printf '%s' "$pair" | sed -E 's/^"([^"]+)".*/\1/')
        value=$(printf '%s' "$pair" | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')

        printf '%s' "$value" | grep -qE "$placeholder" && continue
        printf '%s' "$value" | grep -qE "$looks_real" || continue

        echo "pre-commit: $file — '$key' looks like a real credential."
        echo "  Move it out of the tracked file:"
        echo "    dotnet user-secrets set \"<Section>:$key\" \"<value>\" --project src/SpaceCraft.Api"
        echo "  Then leave the tracked value empty. Override with --no-verify only if you are certain."
        exit 1
      done || fail=1
done

exit $fail
