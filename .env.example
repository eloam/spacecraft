# Copy to .env and fill in. Never commit the result.
#
# In development these values come from appsettings.Development.json instead; this file
# documents what a real deployment must supply. ASP.NET Core reads double-underscore
# environment variables as nested configuration keys.

# --- Database ---------------------------------------------------------------------------
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=spacecraft;Username=spacecraft;Password=CHANGE_ME

# --- Auth -------------------------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME
Jwt__Issuer=spacecraft
Jwt__Audience=spacecraft-api

# --- Object storage ---------------------------------------------------------------------
# Leave ServiceUrl empty for real AWS S3; set it for MinIO, Cloudflare R2, etc.
ObjectStorage__BucketName=spacecraft
ObjectStorage__ServiceUrl=
ObjectStorage__Region=eu-west-1
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=
ObjectStorage__ForcePathStyle=false

# --- Pipeline ---------------------------------------------------------------------------
# Never set UseSandbox=false outside Development: it executes untrusted generated code
# directly on the host. The worker refuses to start with that combination.
Pipeline__UseSandbox=true
Pipeline__WorkspaceRoot=/var/lib/spacecraft/workspaces
Pipeline__NpmRegistry=https://registry.npmjs.org
# Pinned on purpose: the CLI and its runtime packages are a matched pair.
Pipeline__KiotaImage=mcr.microsoft.com/openapi/kiota:1.34.1
Pipeline__NodeImage=node:22-alpine

# --- Worker -----------------------------------------------------------------------------
# Each concurrent run holds a container; size this to the host's CPU and memory.
Worker__Concurrency=2

# --- Email (Scaleway Transactional Email) ------------------------------------------------
# Required outside Development: startup fails without it rather than silently writing
# password reset links to the log. The sending domain must be verified in the Scaleway
# console (SPF, DKIM and MX records) or every send is rejected.
Email__Scaleway__ApiKey=
Email__Scaleway__ProjectId=
Email__Scaleway__Region=fr-par
Email__Scaleway__FromEmail=noreply@spacecraft.dev
Email__Scaleway__FromName=SpaceCraft

# --- Front end / CORS -------------------------------------------------------------------
Cors__AllowedOrigins__0=https://app.spacecraft.dev
PublicUrls__Api=https://api.spacecraft.dev
PublicUrls__App=https://app.spacecraft.dev
