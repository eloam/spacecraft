# The opt-in .NET 10 documents for running tests through Microsoft.Testing.Platform instead
# of the removed VSTest path.
#
# It does not take effect on SDK 10.0.100: `dotnet test` still fails with "Testing with VSTest
# target is no longer supported", and neither the [dotnet.test:runner] spelling nor
# -p:TestingPlatformDotnetTestSupport=true gets past it. Kept because it is the documented
# form and costs nothing the day the SDK honours it.
#
# Until then, run the test projects directly — they are executables under MTP:
#
#     dotnet run --project tests/SpaceCraft.UnitTests
#
# That is what CI does; see .github/workflows/ci.yml.
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
