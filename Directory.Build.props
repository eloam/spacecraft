<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Left off deliberately. With invariant globalization, string.Normalize(FormD) does not
      decompose accented characters, so slug generation silently mangled non-ASCII names
      ("Café Ürün" became "caf-r-n" instead of "cafe-urun"). Organization and project names
      are user-supplied and international; correct casing and normalisation are worth the
      ICU payload.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- .NET 10 removed the VSTest bridge; opt every test project in to the new runner. -->
  <PropertyGroup>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!-- Analysers: strict on our own code, quiet on generated output. -->
  <PropertyGroup>
    <!--
      Pinned rather than "latest-recommended": that value follows whichever SDK happens to be
      installed, so a build that is clean on a developer machine can fail in CI or in a
      container image on rules the local SDK has never heard of. Same reasoning as pinning
      the Kiota image — reproducibility beats being automatically current.
    -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <!--
      CA1848 LoggerMessage source generators: not worth the ceremony at this scale.
      CA2007  ConfigureAwait(false): no synchronisation context in ASP.NET Core or worker hosts.
      CA1711  Reserved type-name suffixes: "Queue" here names a work queue in the domain sense,
              not a Queue<T> subclass. The rule has no way to tell those apart.
    -->
    <!--
      CA1848/CA1873 both push every log call through a source generator. Worth it in hot
      paths — the run queue does exactly that — but not for once-per-step pipeline logging,
      where it trades readability for an allocation nobody will measure.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1711</NoWarn>
  </PropertyGroup>

</Project>
