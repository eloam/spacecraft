{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "spacecraft",
    "Audience": "spacecraft-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "ServiceUrl": "https://s3.fr-par.scw.cloud",
    "BucketName": "openapi-bucket",
    "Region": "fr-par",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false
  },
  "PipelineJobs": {
    "//": "Starting a pipeline job is the only control-plane call the platform makes. SecretKey must be an API key that can start this job definition and nothing wider, and it must never be given to the runner: that process executes a customer's build.",
    "BaseUrl": "https://api.scaleway.com",
    "Region": "fr-par",
    "JobDefinitionId": "",
    "SecretKey": ""
  },
  "PublicUrls": {
    "Api": "https://api.spacecraft.sh",
    "App": "https://app.spacecraft.sh"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*",
  "Email": {
    "Smtp": {
      "Host": "smtp.tem.scaleway.com",
      "Port": 465,
      "Security": "ImplicitTls",
      "RequireCertificateRevocation": true,
      "Username": "",
      "Password": "",
      "FromEmail": "noreply@spacecraft.sh",
      "FromName": "SpaceCraft"
    }
  }
}
