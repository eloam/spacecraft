{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "spacecraft",
    "Audience": "spacecraft-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "BucketName": "spacecraft",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Pipeline": {
    "Sandbox": "Container",
    "KiotaImage": "mcr.microsoft.com/openapi/kiota:1.34.1",
    "NodeImage": "node:22-alpine",
    "NpmRegistry": "https://registry.npmjs.org"
  },
  "PublicUrls": {
    "Api": "https://api.spacecraft.dev",
    "App": "https://app.spacecraft.dev"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
