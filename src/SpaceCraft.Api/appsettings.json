{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "//": "Required: Postgres",
    "Postgres": ""
  },
  "Jwt": {
    "//": "Required: SigningKey (32+ chars)",
    "Issuer": "spacecraft",
    "Audience": "spacecraft-api",
    "SigningKey": ""
  },
  "ObjectStorage": {
    "//": "Required: BucketName, Region. Required outside Development: ServiceUrl, AccessKey, SecretKey",
    "ServiceUrl": "",
    "BucketName": "",
    "Region": "",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false
  },
  "PipelineJobs": {
    "//": "Required: BaseUrl (absolute URL; https outside Development), Region, JobDefinitionId, SecretKey",
    "BaseUrl": "",
    "Region": "",
    "JobDefinitionId": "",
    "SecretKey": "",
    "SweepSeconds": 5,
    "BatchSize": 5,
    "RedispatchAfterSeconds": 120
  },
  "PublicUrls": {
    "//": "Required: App, Api (absolute URLs; https outside Development)",
    "Api": "",
    "App": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "KeyProtection": {
    "//": "Required outside Development: Provider=ScalewayKms, BaseUrl (https), Region, KeyId (UUID), SecretKey",
    "Provider": "None",
    "BaseUrl": "",
    "Region": "",
    "KeyId": "",
    "SecretKey": ""
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimits": {
    "GlobalPermitsPerMinute": 300,
    "CredentialPermitsPerWindow": 10,
    "CredentialWindow": "00:15:00"
  },
  "Notifications": {
    "SweepSeconds": 15,
    "BatchSize": 50,
    "PurgeHours": 6,
    "ReadRetentionDays": 30,
    "UnreadRetentionDays": 90
  },
  "Smtp": {
    "//": "Required: FromEmail. Required outside Development: Host, Username, Password, with Security not None",
    "Host": "",
    "Port": 465,
    "Security": "ImplicitTls",
    "RequireCertificateRevocation": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "SpaceCraft"
  }
}
