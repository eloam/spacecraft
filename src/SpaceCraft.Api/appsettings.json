{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "spacecraft",
    "Audience": "spacecraft-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Scaleway": {
    "//": "Account-level, shared by every Scaleway-facing service. The sending domain and the buckets live in this project.",
    "ProjectId": "[REQUIRED]"
  },
  "ObjectStorage": {
    "ServiceUrl": "https://s3.fr-par.scw.cloud",
    "BucketName": "openapi-bucket",
    "Region": "fr-par",
    "AccessKey": "[REQUIRED]",
    "SecretKey": "[REQUIRED]",
    "ForcePathStyle": false
  },
  "Pipeline": {
    "Sandbox": "Container",
    "KiotaImage": "mcr.microsoft.com/openapi/kiota:1.34.1",
    "NodeImage": "node:22-alpine",
    "NpmRegistry": "https://registry.npmjs.org"
  },
  "PublicUrls": {
    "Api": "https://api.spacecraft.sh",
    "App": "https://app.spacecraft.sh"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*",
  "Email": {
    "Smtp": {
      "Host": "smtp.tem.scaleway.com",
      "Port": 465,
      "UseImplicitTls": true,
      "Username": "[REQUIRED]",
      "Password": "[REQUIRED]",
      "FromEmail": "noreply@spacecraft.sh",
      "FromName": "SpaceCraft"
    }
  }
}
