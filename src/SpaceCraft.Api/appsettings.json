{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "//": "Required: Postgres",
    "Postgres": ""
  },
  "Jwt": {
    "//": "Required: SigningKey (32+ chars)",
    "Issuer": "spacecraft",
    "Audience": "spacecraft-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "//": "Required: BucketName, Region. Required outside Development: ServiceUrl, AccessKey, SecretKey",
    "ServiceUrl": "",
    "BucketName": "",
    "Region": "",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false
  },
  "PipelineJobs": {
    "//": "Required: BaseUrl (absolute URL; https outside Development), Region, JobDefinitionId, SecretKey",
    "BaseUrl": "",
    "Region": "",
    "JobDefinitionId": "",
    "SecretKey": "",
    "SweepSeconds": 5,
    "BatchSize": 5,
    "RedispatchAfterSeconds": 120
  },
  "PublicUrls": {
    "//": "Required: App, Api (absolute URLs; https outside Development)",
    "Api": "",
    "App": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "KeyProtection": {
    "//": "Required outside Development: Provider=ScalewayKms, Kms:BaseUrl (https), Kms:Region, Kms:KeyId (UUID), Kms:SecretKey",
    "Provider": "None",
    "Kms": {
      "BaseUrl": "",
      "Region": "",
      "KeyId": "",
      "SecretKey": ""
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "//": "Required: Smtp:FromEmail. Required outside Development: Smtp:Host, Smtp:Username, Smtp:Password, with Smtp:Security not None",
    "Smtp": {
      "Host": "",
      "Port": 465,
      "Security": "ImplicitTls",
      "RequireCertificateRevocation": true,
      "Username": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "SpaceCraft",
      "Timeout": "00:00:30",
      "AttemptTimeout": "00:00:08",
      "MaxRetries": 3
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimits": {
    "GlobalPermitsPerMinute": 300,
    "CredentialPermitsPerWindow": 10,
    "CredentialWindow": "00:15:00"
  },
  "Notifications": {
    "SweepSeconds": 15,
    "BatchSize": 50,
    "PurgeHours": 6,
    "ReadRetentionDays": 30,
    "UnreadRetentionDays": 90
  }
}
