{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=spacecraft;Username=spacecraft;Password=spacecraft"
  },
  "Jwt": {
    "//": "Development-only key. Production must supply this via environment or a secret store.",
    "SigningKey": "dev-only-signing-key-not-for-production-use-32b"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Pipeline": {
    "NpmRegistry": "http://localhost:4873",
    "WorkspaceRoot": "/tmp/spacecraft-workspaces"
  },
  "PublicUrls": {
    "Api": "http://localhost:8080",
    "App": "http://localhost:5173"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Scaleway": {
    "//": "Blank rather than [REQUIRED]: a checkout has to start without an account. Real values go in user secrets.",
    "ProjectId": ""
  },
  "ObjectStorage": {
    "AccessKey": "",
    "SecretKey": ""
  },
  "Email": {
    "//": "Blank credentials select the logging transport, which is how a reset link is followed without a relay.",
    "Smtp": {
      "Username": "",
      "Password": ""
    }
  }
}
