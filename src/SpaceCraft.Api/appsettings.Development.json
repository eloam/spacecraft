{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=spacecraft;Username=spacecraft;Password=spacecraft"
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-not-for-production-use-32b"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "PublicUrls": {
    "Api": "http://localhost:8080",
    "App": "http://localhost:5173"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "KeyProtection": {
    "Provider": "ScalewayKms",
    "Kms": {
      "BaseUrl": "http://localhost:8099",
      "Region": "fr-par",
      "KeyId": "00000000-0000-4000-8000-000000000001",
      "SecretKey": "fake-token"
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "spacecraft",
    "SecretKey": "spacecraft-dev-secret",
    "ForcePathStyle": true
  },
  "PipelineJobs": {
    "BaseUrl": "http://localhost:8098",
    "Region": "fr-par",
    "JobDefinitionId": "spacecraft-pipeline",
    "SecretKey": "fake-token",
    "SweepSeconds": 2
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None",
      "Username": "spacecraft",
      "Password": "spacecraft-dev",
      "RequireCertificateRevocation": false
    }
  }
}
