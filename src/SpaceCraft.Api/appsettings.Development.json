{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=spacecraft;Username=spacecraft;Password=spacecraft"
  },
  "Jwt": {
    "//": "Development-only key. Production must supply this via environment or a secret store.",
    "SigningKey": "dev-only-signing-key-not-for-production-use-32b"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Pipeline": {
    "NpmRegistry": "http://localhost:4873",
    "WorkspaceRoot": "/tmp/spacecraft-workspaces"
  },
  "PublicUrls": {
    "Api": "http://localhost:8080",
    "App": "http://localhost:5173"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "ObjectStorage": {
    "//": "MinIO from docker-compose. Staging and production point at Scaleway instead; the application speaks the same S3 API to either. ForcePathStyle is the one difference — MinIO serves bucket-in-path, Scaleway and AWS serve virtual-hosted style.",
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "spacecraft",
    "SecretKey": "spacecraft-dev-secret",
    "ForcePathStyle": true
  },
  "Email": {
    "Smtp": {
      "RequireCertificateRevocation": false
    }
  }
}
