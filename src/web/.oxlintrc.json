{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "no-duplicate-imports": "error",
    // Not in eslint-plugin-jsx-a11y's recommended set: role="status" on a div is the live
    // region ARIA in HTML documents, and <output> is a form element.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The recommended set's own settings: a first field focused when a dialog opens is
    // expected, and the Switch is a Base UI control the rule cannot see through.
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Switch"],
        "depth": 3
      }
    ]
  },
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      // shadcn's own files, replaced by `npx shadcn add`, not written here.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    }
  ]
}
