{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "//": "Required: Postgres",
    "Postgres": ""
  },
  "ObjectStorage": {
    "//": "Required: BucketName, Region. Required outside Development: ServiceUrl, AccessKey, SecretKey",
    "ServiceUrl": "",
    "BucketName": "",
    "Region": "",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false
  },
  "KeyProtection": {
    "//": "Required outside Development: Provider=ScalewayKms, BaseUrl (https), Region, KeyId (UUID), SecretKey, identical to the API's (one key ring)",
    "Provider": "None",
    "BaseUrl": "",
    "Region": "",
    "KeyId": "",
    "SecretKey": ""
  },
  "Pipeline": {
    "//": "Required outside Development: AllowUnsandboxedExecution=true",
    "WorkspaceRoot": "/tmp/spacecraft-workspaces",
    "DependencyRegistry": "https://registry.npmjs.org",
    "GenerateTimeout": "00:05:00",
    "BuildTimeout": "00:15:00",
    "PublishTimeout": "00:05:00",
    "RetainWorkspaces": false,
    "AllowUnsandboxedExecution": false
  }
}
