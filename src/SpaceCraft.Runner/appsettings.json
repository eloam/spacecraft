{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ObjectStorage": {
    "BucketName": "spacecraft",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Pipeline": {
    "NpmRegistry": "https://registry.npmjs.org"
  },
  "Runner": {
    "Concurrency": 1,
    "MaxRunsPerInvocation": 25,
    "MaxDuration": "01:00:00",
    "EmptyQueueGrace": "00:00:02"
  }
}
