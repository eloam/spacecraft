{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ObjectStorage": {
    "BucketName": "openapi-bucket",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Pipeline": {
    "DependencyRegistry": "https://registry.npmjs.org"
  }
}
