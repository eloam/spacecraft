{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ObjectStorage": {
    "BucketName": "spacecraft",
    "Region": "us-east-1",
    "ForcePathStyle": true
  },
  "Pipeline": {
    "Sandbox": "Container",
    "KiotaImage": "mcr.microsoft.com/openapi/kiota:1.34.1",
    "NodeImage": "node:22-alpine",
    "NpmRegistry": "https://registry.npmjs.org"
  },
  "Worker": {
    "Concurrency": 2,
    "PollInterval": "00:00:05",
    "MaxPollInterval": "00:00:30",
    "ReaperInterval": "00:01:00"
  }
}
